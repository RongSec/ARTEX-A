# V15-HOSTBIN：在已跑通的 v14 上加一层「预编译 Go 工具」。
#
# 为什么是增量层而不是回到全量 Dockerfile：
#   构建机 4C/7G（可用内存约 1G）。v14 之前为了让这些工具跑起来，曾尝试在
#   镜像里 `go install`——nuclei v3 单次编译 36 分钟，导出层时 OOM。工具本身
#   全都提供官方 linux-amd64 静态二进制，所以正解不是加内存，是**不编译**：
#   二进制由 docker/hostbin/fetch.sh 在有外网的机器上取好，这里只 COPY 一层。
#
# 构建（上下文就是 hostbin 目录，几百 MB，秒级完成）：
#   cd /root/Desktop/sec/artex-hs/hostbin
#   docker build -f Dockerfile.hostbin -t artex-hs-local:v15 .
#
# 校验：逐件 test -f + 逐个 `--version`，任何一个跑不起来就让构建失败，
#       不留「镜像构建成功但工具是坏的」这种坑。

FROM artex-hs-local:v14

# 拷整个目录到暂存区再逐件校验。
#
# 为什么不用 `COPY nuclei httpx ... /usr/local/bin/`：
#   COPY 遇到不存在的源文件只报「file not found」，不说是哪个；真缺件时
#   已存在的文件仍会写进层里，得到一个「部分工具可用」的半残镜像。
#   逐件 test -f 能在构建日志里直接点名缺哪个，并提示去跑 fetch.sh。
COPY . /tmp/hostbin/

# 同一层顺带换掉 artex 主程序：工具层和业务层一起发版，避免「镜像里工具是新的、
# 二进制还是旧的」这种半更新态。artex 由本机交叉编译（CGO_ENABLED=0），
# 不带动态依赖，COPY 进来即可跑。
COPY artex /app/artex

RUN set -eux; \
    # 必需件：缺任何一个都让构建失败（这些是主力扫描件，缺了等于功能残废）。
    for f in nuclei httpx subfinder katana dnsx tlsx chisel; do \
      test -f "/tmp/hostbin/$f" || { \
        echo "缺少预编译二进制: $f —— 在构建机执行 bash docker/hostbin/fetch.sh 后重试" >&2; \
        exit 1; \
      }; \
      install -m 0755 "/tmp/hostbin/$f" "/usr/local/bin/$f"; \
    done; \
    # 可选件：ffuf/dalfox 走目录爆破与 XSS，页面也能联网装。缺了只告警，
    # 不阻断发版——把「构建机拿不到 GitHub release」变成发版阻塞点不划算。
    for f in ffuf dalfox; do \
      if [ -f "/tmp/hostbin/$f" ]; then \
        install -m 0755 "/tmp/hostbin/$f" "/usr/local/bin/$f"; \
      else \
        echo "WARN: 可选件 $f 未预置（运行时可通过「宿主环境」页安装）" >&2; \
      fi; \
    done; \
    chmod 0755 /app/artex; \
    rm -rf /tmp/hostbin; \
    # 逐个自检：能打印版本才算装好（静态二进制不依赖 libc，正常不会有动态库缺失）
    nuclei -version | head -1; \
    httpx -version | head -1; \
    subfinder -version 2>&1 | head -1; \
    katana -version | head -1; \
    dnsx -version | head -1; \
    tlsx -version | head -1; \
    command -v ffuf >/dev/null && ffuf -V | head -1 || true; \
    command -v dalfox >/dev/null && dalfox version 2>&1 | head -1 || true; \
    chisel --version | head -1

# nuclei 的版本自检/模板自动更新在内网会卡住（连不上 GitHub），默认关掉；
# 模板目录由 compose 挂到 $HOME/nuclei-templates（见 docker-compose.hs.yml）。
ENV NUCLEI_DISABLE_UPDATE_CHECK=true
