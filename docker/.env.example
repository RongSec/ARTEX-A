# artex Docker 配置（复制为 docker/.env 后按需改）
# 宿主机端口（容器内部固定 8787，见 ARTEX_LISTEN_ADDR）
ARTEX_HTTP_PORT=8801
# 容器内监听地址 / 数据目录
ARTEX_LISTEN_ADDR=:8787
ARTEX_DATA_DIR=/app/data

# PostgreSQL（compose 自带 postgres:16；用宿主库时把 ARTEX_PG_DSN 指向宿主）
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
ARTEX_PG_DSN=postgres://artex:change-me-please@postgres:5432/artex?sslmode=disable

# 首次启动自动设置的管理员密码（用户名固定 ARTEX；已设置过则忽略）
ARTEX_INIT_PASSWORD=change-me-please

# 镜像名（本地构建产物）
ARTEX_IMAGE=artex:local
