# docker/.env 的字段说明（真正的文件由 ./run.sh 或 init-env.sh 生成）。
#
# 这是系统**唯一的机密文件**：数据库口令、管理员密码、LLM key、搜索 key、
# NVD/GitHub token、代理账号都在这里。生成后权限 0600，已在 .gitignore。
# 备份它就够了；不要把这些值写进 compose、config.json 或代码里。
#
# 不要直接复制本文件改名使用 —— 它没有随机口令。跑 ./run.sh 即可。

# ── 部署形态 ────────────────────────────────────────────────
# 镜像：latest 跟着最新正式版走；要锁版本就写 rongsec/artex-a:v0.3.16-hs.7
ARTEX_IMAGE=rongsec/artex-a:latest
# 应用监听（host 网络下就是对外端口；Docker Desktop 下用 -p 映射）
ARTEX_LISTEN_ADDR=:8801
# 下面两个必须和上一行的端口一致（compose 的端口映射不会解析地址串）
ARTEX_LISTEN_PORT=8801
ARTEX_HTTP_PORT=8801
# 流量录制代理（只绑回环）
ARTEX_PROXY_ADDR=127.0.0.1:8802
# 数据目录：模板、报告、hostbin、技能、apt 缓存
ARTEX_DATA_DIR=./data

# ── 数据库（compose 自带的 artex-db）────────────────────────
# 用外部 PostgreSQL：改成 0，并把 ARTEX_PG_DSN 指向那个库（compose 不再起库）
ARTEX_EMBEDDED_DB=1
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex
# 只绑 127.0.0.1；55432 避开宿主机默认的 5432
ARTEX_DB_PORT=55432
ARTEX_PG_DSN=postgres://artex:change-me-please@127.0.0.1:55432/artex?sslmode=disable

# 首次启动的管理员初始密码（用户名固定 ARTEX；已建账号后无效）
ARTEX_INIT_PASSWORD=change-me-please

# ── 机密（留空也能启动，填了启动时自动导入数据库）───────────
# LLM：格式 openai / anthropic / openai-responses；接中转网关时 base_url 填到 /v1
ARTEX_LLM_FORMAT=
ARTEX_LLM_API_KEY=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_MODEL=
ARTEX_LLM_PROXY=
# 兼容官方变量名（优先级低于 ARTEX_LLM_API_KEY）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 联网搜索（不填用免密的 ddgs）
ARTEX_BRAVE_API_KEY=
ARTEX_TAVILY_API_KEY=

# 漏洞情报
ARTEX_NVD_API_KEY=
ARTEX_GITHUB_TOKEN=

# 代理：目标流量走 global，检索/情报走 outbound
ARTEX_OUTBOUND_PROXY=
ARTEX_GLOBAL_PROXY=
